/* Phase 1 — db2delta arg parsing unit tests (no DB needed) */
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include "../src/args.h"

static int failed = 0;
static int passed = 0;

#define CHECK(expr) \
    do { if (!(expr)) { \
        printf("  FAIL [%d]: %s\n", __LINE__, #expr); failed++; \
    } else { passed++; } } while(0)

#define CHECK_EQ(a,b) \
    do { if ((a)!=(b)) { \
        printf("  FAIL [%d]: %s==%s  (%d != %d)\n", __LINE__, #a, #b, (int)(a),(int)(b)); \
        failed++; \
    } else { passed++; } } while(0)

#define CHECK_STR(a,b) \
    do { if (strcmp((a),(b))!=0) { \
        printf("  FAIL [%d]: '%s' != '%s'\n", __LINE__, (a), (b)); failed++; \
    } else { passed++; } } while(0)

static void test_dsn_parse(void) {
    printf("  T1: DSN parse host:port/db\n");
    db2delta_args_t a; memset(&a, 0, sizeof(a));
    CHECK_EQ(args_parse_dsn("db2host:50000/TESTDB", &a), 0);
    CHECK_STR(a.host, "db2host");
    CHECK_EQ(a.port, 50000);
    CHECK_STR(a.database, "TESTDB");

    printf("  T2: DSN parse host/db (no port)\n");
    memset(&a, 0, sizeof(a));
    CHECK_EQ(args_parse_dsn("myhost/MYDB", &a), 0);
    CHECK_STR(a.host, "myhost");
    CHECK_EQ(a.port, 0);
    CHECK_STR(a.database, "MYDB");

    printf("  T3: DSN with 127.0.0.1\n");
    memset(&a, 0, sizeof(a));
    CHECK_EQ(args_parse_dsn("127.0.0.1:50001/SAMPLEDB", &a), 0);
    CHECK_STR(a.host, "127.0.0.1");
    CHECK_EQ(a.port, 50001);
    CHECK_STR(a.database, "SAMPLEDB");

    printf("  T4: DSN missing slash → error\n");
    memset(&a, 0, sizeof(a));
    CHECK_EQ(args_parse_dsn("noslash", &a), -1);

    printf("  T5: DSN port out of range → error\n");
    memset(&a, 0, sizeof(a));
    CHECK_EQ(args_parse_dsn("host:99999/DB", &a), -1);
}

static void test_version_mode(void) {
    printf("  T6: -d host:50000/TESTDB -u db2inst1 -V → MODE_VERSION\n");
    db2delta_args_t a; memset(&a, 0, sizeof(a));
    char *argv[] = {"db2delta", "-d", "db2host:50000/TESTDB",
                    "-u", "db2inst1", "-V", NULL};
    CHECK_EQ(args_parse(6, argv, &a), 0);
    CHECK_EQ(a.mode, MODE_VERSION);
    CHECK_STR(a.host, "db2host");
    CHECK_EQ(a.port, 50000);
    CHECK_STR(a.database, "TESTDB");
    CHECK_STR(a.user, "db2inst1");
}

static void test_query_mode(void) {
    printf("  T7: -d h/DB -u u -q 'SELECT 1' → MODE_QUERY\n");
    db2delta_args_t a; memset(&a, 0, sizeof(a));
    char *argv[] = {"db2delta", "-d", "h/DB", "-u", "u",
                    "-q", "SELECT 1 FROM SYSIBM.SYSDUMMY1", NULL};
    CHECK_EQ(args_parse(7, argv, &a), 0);
    CHECK_EQ(a.mode, MODE_QUERY);
    CHECK_STR(a.query, "SELECT 1 FROM SYSIBM.SYSDUMMY1");
}

static void test_apply_mode(void) {
    printf("  T8: -d h/DB -u u -s a.delta b.delta → MODE_APPLY, 2 files\n");
    db2delta_args_t a; memset(&a, 0, sizeof(a));
    char *argv[] = {"db2delta", "-d", "h/DB", "-u", "u",
                    "-s", "a.delta", "b.delta", NULL};
    CHECK_EQ(args_parse(8, argv, &a), 0);
    CHECK_EQ(a.mode, MODE_APPLY);
    CHECK_EQ(a.sql_file_count, 2);
    CHECK_STR(a.sql_files[0], "a.delta");
    CHECK_STR(a.sql_files[1], "b.delta");
}

static void test_flags(void) {
    printf("  T9: -x -c flags\n");
    db2delta_args_t a; memset(&a, 0, sizeof(a));
    char *argv[] = {"db2delta", "-d", "h/DB", "-u", "u",
                    "-V", "-x", "-c", NULL};
    CHECK_EQ(args_parse(8, argv, &a), 0);
    CHECK_EQ(a.script_mode, 1);
    CHECK_EQ(a.continue_on_error, 1);

    printf("  T9b: --continue-on-error long form\n");
    memset(&a, 0, sizeof(a));
    char *argv2[] = {"db2delta", "-d", "h/DB", "-u", "u",
                     "-V", "--continue-on-error", NULL};
    CHECK_EQ(args_parse(7, argv2, &a), 0);
    CHECK_EQ(a.continue_on_error, 1);
}

static void test_missing_dsn(void) {
    printf("  T10: missing -d → error\n");
    db2delta_args_t a; memset(&a, 0, sizeof(a));
    char *argv[] = {"db2delta", "-u", "u", "-V", NULL};
    int r = args_parse(4, argv, &a);
    CHECK(r != 0 || a.mode == MODE_USAGE);
}

static void test_missing_user(void) {
    printf("  T11: missing -u → error\n");
    db2delta_args_t a; memset(&a, 0, sizeof(a));
    char *argv[] = {"db2delta", "-d", "h/DB", "-V", NULL};
    int r = args_parse(4, argv, &a);
    CHECK(r != 0 || a.mode == MODE_USAGE);
}

static void test_password(void) {
    printf("  T12: -p sets password\n");
    db2delta_args_t a; memset(&a, 0, sizeof(a));
    char *argv[] = {"db2delta", "-d", "h/DB", "-u", "u",
                    "-p", "s3cr3t", "-V", NULL};
    CHECK_EQ(args_parse(8, argv, &a), 0);
    CHECK_STR(a.password, "s3cr3t");
}

int main(void) {
    printf("=== Phase 1 — db2delta arg parsing tests ===\n\n");

    test_dsn_parse();
    test_version_mode();
    test_query_mode();
    test_apply_mode();
    test_flags();
    test_missing_dsn();
    test_missing_user();
    test_password();

    printf("\n=== Result: %d passed, %d failed ===\n", passed, failed);
    return failed ? 1 : 0;
}
