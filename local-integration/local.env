# Local integration environment — sourced by all scripts.
# Keep secrets out of git; these are local dev credentials only.

# ── DB2 container ──────────────────────────────────────────────────────────────
DB2_CONTAINER=db2server-libstaticdb2
DB2_IMAGE=icr.io/db2_community/db2:11.5.9.0
DB2_BIND_MOUNT=/var/docker-db2-libstaticdb2

DB2_HOST=127.0.0.1
DB2_PORT=50001
DB2_DB=TESTDB
DB2_INST=db2inst1
DB2_USERNAME=db2inst1
DB2_PASSWORD=db2inst1
