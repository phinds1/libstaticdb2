/* Phase 15 — Hardening / parser fuzz tests
 *
 * Verifies that DSS, DDM, and FD:OCA parsers never crash (SIGSEGV/abort) when
 * fed truncated, empty, or garbage byte buffers.  Each test feeds a malformed
 * input and asserts a non-SDB2_OK return code is returned (not a crash).
 *
 * Also verifies:
 *   - Static binary (checked externally via `ldd`)
 *   - Handle lifecycle: alloc/free does not leak (verified by running under
 *     valgrind if available: `valgrind --error-exitcode=1 ./run_p15_hard`)
 *   - Full snip suite passes (run from Makefile: `make test`)
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#include "buf.h"
#include "dss.h"
#include "ddm.h"
#include "fdoca.h"
#include "drda.h"
#include "staticdb2/sdb2.h"
#include "staticdb2/sql.h"
#include "handles.h"
#include "asserts.h"

#define PASS(msg) assert((msg), 1)
#define FAIL(msg) assert((msg), 0)
#define ASSERT(cond, msg) assert((msg), (cond))
#define ASSERT_ERR(rc, msg) ASSERT((rc) != SDB2_OK, msg)

/* Feed n bytes to a buf_t in read mode. */
static void buf_load(buf_t *b, const uint8_t *data, size_t n) {
    buf_reset(b);
    buf_ensure(b, n);
    memcpy(b->data, data, n);
    b->pos   = 0;
    b->limit = n;
}

/* ---- DSS header parser fuzz ---- */
static void fuzz_dss_header(void) {
    buf_t b;
    buf_init(&b, 64);
    dss_hdr_t hdr;

    /* Empty buffer */
    buf_load(&b, NULL, 0);
    ASSERT_ERR(dss_read_header(&b, &hdr), "DSS: empty buffer → error");

    /* Too short (< 6 bytes) */
    uint8_t short_hdr[4] = { 0x00, 0x08, 0xD0, 0x01 };
    buf_load(&b, short_hdr, sizeof(short_hdr));
    ASSERT_ERR(dss_read_header(&b, &hdr), "DSS: 4-byte truncated header → error");

    /* Bad magic byte */
    uint8_t bad_magic[8] = { 0x00, 0x08, 0xFF, 0x01, 0x00, 0x01, 0x21, 0x00 };
    buf_load(&b, bad_magic, sizeof(bad_magic));
    int r = dss_read_header(&b, &hdr);
    /* bad magic should either error or parse (implementation defined), but must not crash */
    (void)r;
    PASS("DSS: bad magic byte — no crash");

    /* All zeros */
    uint8_t zeros[8] = { 0 };
    buf_load(&b, zeros, sizeof(zeros));
    /* Must not crash; may error on zero-length DSS */
    dss_read_header(&b, &hdr);
    PASS("DSS: all-zeros — no crash");

    /* All 0xFF */
    uint8_t allff[8];
    memset(allff, 0xFF, sizeof(allff));
    buf_load(&b, allff, sizeof(allff));
    dss_read_header(&b, &hdr);
    PASS("DSS: all-0xFF — no crash");

    buf_free(&b);
}

/* ---- DDM header reader fuzz ---- */
static void fuzz_ddm_header(void) {
    buf_t b;
    buf_init(&b, 64);
    ddm_hdr_t hdr;
    int r;

    /* Empty */
    buf_load(&b, NULL, 0);
    ASSERT_ERR(ddm_read_hdr(&b, &hdr), "DDM: empty buffer → error");

    /* Too short (< 4 bytes) */
    uint8_t short3[3] = { 0x00, 0x10, 0x21 };
    buf_load(&b, short3, sizeof(short3));
    ASSERT_ERR(ddm_read_hdr(&b, &hdr), "DDM: 3-byte header → error");

    /* Length field < 4 (impossibly short) */
    uint8_t tiny[4] = { 0x00, 0x02, 0x21, 0x00 };
    buf_load(&b, tiny, sizeof(tiny));
    r = ddm_read_hdr(&b, &hdr);
    /* Should error on impossible length */
    (void)r;
    PASS("DDM: length<4 — no crash");

    /* Garbage 16 bytes */
    uint8_t garbage[16];
    for (int i = 0; i < 16; i++) garbage[i] = (uint8_t)(i * 37 + 13);
    buf_load(&b, garbage, sizeof(garbage));
    ddm_read_hdr(&b, &hdr);
    PASS("DDM: garbage 16 bytes — no crash");

    buf_free(&b);
}

/* ---- FD:OCA QRYDSC parser fuzz ---- */
static void fuzz_fdoca_qrydsc(void) {
    buf_t b;
    buf_init(&b, 64);
    fdoca_result_t res;
    memset(&res, 0, sizeof(res));
    int r;

    /* Empty: ddm_payload_len=0 → SDB2_OK with 0 cols (valid empty descriptor) */
    buf_load(&b, NULL, 0);
    r = fdoca_parse_qrydsc(&b, 0, &res);
    ASSERT(r == SDB2_OK && res.ncols == 0, "FD:OCA: empty QRYDSC → OK, 0 cols");
    free(res.cols); res.cols = NULL;

    /* Single byte */
    uint8_t one = 0xFF;
    buf_load(&b, &one, 1);
    r = fdoca_parse_qrydsc(&b, 1, &res);
    free(res.cols); res.cols = NULL;
    PASS("FD:OCA: single byte — no crash");

    /* Truncated in the middle of a column descriptor */
    uint8_t partial[8] = { 0x76, 0xA0, 0x00, 0x03, 0x04, 0x44, 0x00, 0x04 };
    buf_load(&b, partial, sizeof(partial));
    r = fdoca_parse_qrydsc(&b, sizeof(partial), &res);
    free(res.cols); res.cols = NULL;
    PASS("FD:OCA: truncated column descriptor — no crash");

    /* All zeros, 32 bytes */
    uint8_t zeros[32] = {0};
    buf_load(&b, zeros, sizeof(zeros));
    r = fdoca_parse_qrydsc(&b, sizeof(zeros), &res);
    free(res.cols); res.cols = NULL;
    PASS("FD:OCA: all-zeros 32 bytes — no crash");

    /* All 0xFF, 32 bytes */
    uint8_t allff[32];
    memset(allff, 0xFF, sizeof(allff));
    buf_load(&b, allff, sizeof(allff));
    r = fdoca_parse_qrydsc(&b, sizeof(allff), &res);
    free(res.cols); res.cols = NULL;
    PASS("FD:OCA: all-0xFF 32 bytes — no crash");

    /* Large column count: claim many columns with tiny buffer */
    uint8_t big_n[8] = { 0x76, 0xA0, 0x00, 0x80, 0x04, 0x44, 0x00, 0x08 };
    buf_load(&b, big_n, sizeof(big_n));
    r = fdoca_parse_qrydsc(&b, sizeof(big_n), &res);
    free(res.cols); res.cols = NULL;
    PASS("FD:OCA: oversized column count — no crash");

    (void)r;
    buf_free(&b);
}

/* ---- FD:OCA decode_col fuzz (truncated row data) ---- */
static void fuzz_fdoca_decode_col(void) {
    sdb2_value_t val;

    /* Build a fake INTEGER column descriptor (nullable, 4 bytes) */
    fdoca_col_t col;
    memset(&col, 0, sizeof(col));
    col.drda_type = 0x02;       /* INTEGER (nullable wire type is DT+1=0x03, but use 0x02 here) */
    col.sdb2_type = SDB2_C_INT32;
    col.length    = 4;
    col.nullable  = 1;
    col.scale     = 0;
    col.precision = 10;

    /* Empty buffer: null indicator byte missing */
    ASSERT_ERR(fdoca_decode_col(&col, NULL, 0, &val), "FD:OCA decode: empty → error");

    /* Only null indicator, no value bytes */
    uint8_t not_null[1] = { 0x00 };
    ASSERT_ERR(fdoca_decode_col(&col, not_null, 1, &val), "FD:OCA decode: null=0 but no value bytes → error");

    /* NULL indicator present */
    uint8_t null_ind[1] = { 0xFF };
    int r = fdoca_decode_col(&col, null_ind, 1, &val);
    ASSERT(r == SDB2_OK && val.is_null, "FD:OCA decode: null indicator → val.is_null");

    /* Truncated VARCHAR */
    col.drda_type = 0x20;  /* VARCHAR */
    col.length    = 32;
    col.nullable  = 0;
    uint8_t partial_vc[3] = { 0x00, 0x10, 0x41 }; /* claims length=16 but only 1 data byte */
    ASSERT_ERR(fdoca_decode_col(&col, partial_vc, sizeof(partial_vc), &val), "FD:OCA decode: truncated VARCHAR → error");

    /* Garbage bytes for INTEGER (non-nullable) */
    col.drda_type = 0x02;
    col.sdb2_type = SDB2_C_INT32;
    col.length    = 4;
    col.nullable  = 0;
    uint8_t four[4] = { 0xDE, 0xAD, 0xBE, 0xEF };
    r = fdoca_decode_col(&col, four, 4, &val);
    ASSERT(r == SDB2_OK, "FD:OCA decode: valid 4-byte INTEGER from garbage → SDB2_OK");
    (void)r;
}

/* ---- Handle alloc/free lifecycle ---- */
static void handle_lifecycle(void) {
    SQLHENV henv = SQL_NULL_HANDLE;
    SQLHDBC hdbc = SQL_NULL_HANDLE;
    SQLHSTMT hstmt = SQL_NULL_HANDLE;

    SQLRETURN rc = SQLAllocHandle(SQL_HANDLE_ENV, SQL_NULL_HANDLE, &henv);
    ASSERT(rc == SQL_SUCCESS, "H1: SQLAllocHandle(ENV)");

    rc = SQLAllocHandle(SQL_HANDLE_DBC, henv, &hdbc);
    ASSERT(rc == SQL_SUCCESS, "H2: SQLAllocHandle(DBC)");

    rc = SQLAllocHandle(SQL_HANDLE_STMT, hdbc, &hstmt);
    ASSERT(rc == SQL_SUCCESS, "H3: SQLAllocHandle(STMT)");

    rc = SQLFreeHandle(SQL_HANDLE_STMT, hstmt);
    ASSERT(rc == SQL_SUCCESS, "H4: SQLFreeHandle(STMT)");

    rc = SQLFreeHandle(SQL_HANDLE_DBC, hdbc);
    ASSERT(rc == SQL_SUCCESS, "H5: SQLFreeHandle(DBC)");

    rc = SQLFreeHandle(SQL_HANDLE_ENV, henv);
    ASSERT(rc == SQL_SUCCESS, "H6: SQLFreeHandle(ENV)");
}

/* ---- Multiple handle alloc/free cycles (leak check target) ---- */
static void handle_repeat_cycles(void) {
    for (int i = 0; i < 16; i++) {
        SQLHENV henv = SQL_NULL_HANDLE;
        SQLHDBC hdbc = SQL_NULL_HANDLE;
        SQLAllocHandle(SQL_HANDLE_ENV, SQL_NULL_HANDLE, &henv);
        SQLAllocHandle(SQL_HANDLE_DBC, henv, &hdbc);
        SQLFreeHandle(SQL_HANDLE_DBC, hdbc);
        SQLFreeHandle(SQL_HANDLE_ENV, henv);
    }
    PASS("H7: 16 alloc/free cycles without crash");
}

/* workaround for forward-declared r in inner scopes: none needed */

int main(void) {
    printf("=== Phase 15 — Hardening / fuzz tests ===\n\n");
    printf("--- DSS header parser fuzz ---\n");
    fuzz_dss_header();

    printf("--- DDM header parser fuzz ---\n");
    fuzz_ddm_header();

    printf("--- FD:OCA QRYDSC parser fuzz ---\n");
    fuzz_fdoca_qrydsc();

    printf("--- FD:OCA decode_col fuzz ---\n");
    fuzz_fdoca_decode_col();

    printf("--- Handle lifecycle ---\n");
    handle_lifecycle();
    handle_repeat_cycles();

    print_results("p15_hard");
    return 0;
}
